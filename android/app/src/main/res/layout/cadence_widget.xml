<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cadence" android:textSize="15sp" android:textStyle="bold" android:textColor="#30243D"/>
    <TextView android:id="@+id/widget_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 / 100 min" android:textSize="28sp" android:textStyle="bold" android:textColor="#30243D" android:maxLines="1"/>
    <ProgressBar android:id="@+id/widget_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="5dp" android:progressTint="#A83D2C" android:progressBackgroundTint="#CBBED6" android:max="100"/>
    <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="28dp" android:gravity="center_vertical" android:text="Dein Wochenrhythmus" android:textSize="12sp" android:textColor="#51415F" android:maxLines="2"/>
    <TextView android:id="@+id/widget_start" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center" android:background="@drawable/widget_button" android:text="▶  Üben starten" android:textSize="14sp" android:textStyle="bold" android:textColor="#E9DDF7"/>
</LinearLayout>
