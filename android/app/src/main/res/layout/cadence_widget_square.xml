<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_subtext" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_text" android:maxLines="1"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="30dp">
        <TextView android:id="@+id/widget_headline" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical|start"
            android:textStyle="bold" android:textColor="@color/widget_text" android:maxLines="2"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp"/>
        <Chronometer android:id="@+id/widget_chronometer" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical|start"
            android:textSize="28sp" android:textStyle="bold" android:textColor="@color/widget_text" android:visibility="gone"/>
    </FrameLayout>
    <ProgressBar android:id="@+id/widget_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"
        android:progressTint="@color/widget_progress" android:progressBackgroundTint="@color/widget_track" android:max="100"/>
    <TextView android:id="@+id/widget_start" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="8dp" android:gravity="center"
        android:background="@drawable/widget_button" android:text="▶" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_button_text" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
